{
  "name": "natter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:stable": "next dev --experimental-https",
    "dev:legacy": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "dev:fresh": "./clear-cache.sh",
    "dev:safe": "NODE_ENV=development next dev --port 3000",
    "build": "next build",
    "cf:build": "NEXT_PUBLIC_API_URL=https://api.natter.akaaku.net NEXT_PUBLIC_BASE_URL=https://natter.akaaku.net opennextjs-cloudflare build",
    "cf:preview": "NEXT_PUBLIC_API_URL=https://api.natter.akaaku.net NEXT_PUBLIC_BASE_URL=https://natter.akaaku.net opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "NEXT_PUBLIC_API_URL=https://api.natter.akaaku.net NEXT_PUBLIC_BASE_URL=https://natter.akaaku.net opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:upload": "NEXT_PUBLIC_API_URL=https://api.natter.akaaku.net NEXT_PUBLIC_BASE_URL=https://natter.akaaku.net opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "start-prod": "next start --port 23101",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "knip": "knip",
    "clean": "rm -rf .next node_modules pnpm-lock.yaml && pnpm install",
    "clean:cache": "rm -rf .next node_modules/.cache",
    "dev:clean": "rm -rf .next && pnpm dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tabler/icons-react": "^3.34.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tanstack/react-query": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "heic2any": "^0.0.4",
    "link-auth": "0.1.2",
    "next": "15.5.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.10",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.5.18",
    "knip": "^5.61.3",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "wrangler": "^4.91.0"
  }
}
